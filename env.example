# Copy to `.env` for local overrides, or rely on committed `.env` + `.env.development`.
#
# Local API (development): `vite dev` loads `.env`, then `.env.development` (localhost).
VITE_API_BASE_URL=http://localhost:3000

# Production: `.env.production` is gitignored. Copy `.env.production.example` →
# `.env.production`, set `VITE_API_BASE_URL` to your live API (no trailing slash).
# On CI/CD, set the same variable in the host’s dashboard instead of a file.

# TanStack Query defaults (optional, milliseconds / counts)
# VITE_QUERY_STALE_TIME_MS=60000
# VITE_QUERY_GC_TIME_MS=300000
# VITE_QUERY_RETRY=1
# VITE_MUTATION_RETRY=0
